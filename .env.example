# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/phitsanulok_tourism
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/phitsanulok_tourism

# AI / API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Frontend — แผนที่หน้าเว็บ (ต้องเปิด "Maps JavaScript API" ใน Google Cloud)
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Backend — สคริปต์ fetch_hours_api.py ดึงเวลาทำการครบ 7 วัน (ต้องเปิด "Places API")
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# ── path ภายนอกที่ขึ้นกับเครื่อง ─────────────────────────────
#
# ⚠️ ตรวจทุกอย่างได้ด้วย:  uv run python project_paths.py
#   สคริปต์นั้นเป็นแหล่งความจริงเดียวของ path ทั้งโปรเจกต์
#   path ภายในโปรเจกต์คำนวณจากตำแหน่งไฟล์เอง จึงย้ายเครื่องได้ไม่ต้องแก้
#   เหลือแค่สามกลุ่มด้านล่างที่ขึ้นกับเครื่อง

# โฟลเดอร์ bin ของ PostgreSQL (ที่มี psql.exe / pg_dump.exe)
# ไม่ต้องตั้งถ้า psql อยู่ใน PATH แล้ว หรือถ้าลงไว้ที่ที่พบได้บ่อย
# (D:\PostgreSQL\<ver>, C:\PostgreSQL\<ver>,
#  C:\Program Files\PostgreSQL\<ver>) — project_paths.py หาเองได้
# ตั้งเมื่อหาไม่เจอ หรืออยากบังคับให้ใช้เวอร์ชันที่ต้องการ
# PG_BIN=D:\PostgreSQL\16\bin

# Cache paths (ทางเลือก) — ตั้งเพื่อไม่ให้ cache ไปกินไดรฟ์ C:
# ⚠️ ถ้าเครื่องไม่มีไดรฟ์ D: ให้ลบ/คอมเมนต์ 2 บรรทัดนี้ (จะใช้ค่าเริ่มต้นบน C: แทน)
# หรือแก้ path ให้ตรงกับเครื่องคุณ เช่น C:\AppCache
# PLAYWRIGHT_BROWSERS_PATH=D:\AppCache\ms-playwright
# HF_HOME=D:\AppCache\huggingface
# UV_CACHE_DIR=D:\AppCache\uv
