# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/phitsanulok_tourism
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/phitsanulok_tourism

# AI / API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Frontend — แผนที่หน้าเว็บ (ต้องเปิด "Maps JavaScript API" ใน Google Cloud)
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Backend — สคริปต์ fetch_hours_api.py ดึงเวลาทำการครบ 7 วัน (ต้องเปิด "Places API")
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# Cache paths (แนะนำเก็บนอกโปรเจกต์เพื่อไม่กิน C:)
PLAYWRIGHT_BROWSERS_PATH=D:\AppCache\ms-playwright
HF_HOME=D:\AppCache\huggingface
